{
  "name": "app",
  "version": "1.0.50",
  "module": "src/index.js",
  "scripts": {
    "prepare": "husky",
    "test": "bun test",
    "dev": "bun run --watch src/index.ts",
    "build": "bun build --compile --minify-whitespace --minify-syntax --target bun-linux-x64 --external pg --external kysely --external @better-auth/kysely-adapter --outfile server src/index.ts",
    "check": "bun run format && bun run lint && bun run build",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt . --check"
  },
  "dependencies": {
    "@elysia/cors": "2.0.0-beta.1",
    "@elysia/openapi": "2.0.0-beta.1",
    "@elysia/opentelemetry": "2.0.0-beta.1",
    "@kubiks/otel-drizzle": "^2.1.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.218.0",
    "@opentelemetry/sdk-trace-node": "^2.7.1",
    "better-auth": "^1.6.14",
    "drizzle-orm": "^0.45.2",
    "drizzle-typebox": "^0.3.3",
    "elysia": "2.0.0-beta.2",
    "ioredis": "^5.11.1",
    "pg": "^8.21.0",
    "typebox": "1.3.0"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "bun-types": "latest",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "husky": "^9.1.7",
    "oxfmt": "^0.53.0",
    "oxlint": "^1.68.0"
  }
}
